# Sao chép thành .env rồi đổi các giá trị bên dưới. Không commit file .env.
PORT=5000
NODE_ENV=development

# Chuỗi ngẫu nhiên dài, ví dụ tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origin của front-end được phép gọi API (bỏ trống khi dev để cho phép tất cả)
CORS_ORIGINS=http://localhost:5173

# API key cho hệ thống bên ngoài (để trống = tắt key đó)
ADMIN_API_KEY=
PARTNER_API_KEY=
PUBLIC_API_KEY=
