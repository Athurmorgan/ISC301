{
  "info": {
    "name": "BookWise REST API Collection",
    "description": "Bộ sưu tập API cho 3 luồng nghiệp vụ: 1. CSKH + Dashboard + Giao hàng; 2. Mua bán sách & Giao dịch; 3. Theo dõi đơn hàng. Hỗ trợ xác thực bằng API Key (x-api-key) hoặc JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiKeyAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyPartner",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyClient",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Xác thực & Khởi tạo (Auth & System)",
      "item": [
        {
          "name": "Kiểm tra hệ thống (Health Check)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Kiểm tra API Key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKeyAdmin}}" }
            ],
            "url": "{{baseUrl}}/api/auth/verify-api-key"
          }
        },
        {
          "name": "Đăng nhập Khách hàng / Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookwise.vn\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Luồng 1: CSKH + Dashboard + Giao hàng",
      "item": [
        {
          "name": "1.1 Dashboard: Thống kê KPI tổng hợp",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/summary"
          }
        },
        {
          "name": "1.2 Dashboard: Biểu đồ xu hướng doanh thu",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/revenue-trend"
          }
        },
        {
          "name": "1.3 Dashboard: Cảnh báo sách sắp hết hàng",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/inventory-alerts"
          }
        },
        {
          "name": "1.4 CSKH: Lấy danh sách phiếu hỗ trợ (Tickets)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/support/tickets?status=open"
          }
        },
        {
          "name": "1.5 CSKH: Gửi phiếu hỗ trợ mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"order\",\n  \"name\": \"Khách Hàng Mẫu\",\n  \"email\": \"khachhang@gmail.com\",\n  \"phone\": \"0912345678\",\n  \"orderCode\": \"BW-100582\",\n  \"message\": \"Hàng của mình sắp tới nơi chưa shop ơi?\"\n}"
            },
            "url": "{{baseUrl}}/api/support/tickets"
          }
        },
        {
          "name": "1.6 CSKH: Trả lời & Đóng phiếu hỗ trợ",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKeyAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"Dạ shipper đang trên đường tới đường Cầu Giấy trong 30 phút nữa ạ!\",\n  \"responderName\": \"CSKH Lan Hương\",\n  \"status\": \"resolved\"\n}"
            },
            "url": "{{baseUrl}}/api/support/tickets/TK-8821/reply"
          }
        },
        {
          "name": "1.7 Giao hàng: Tra cứu hành trình vận chuyển",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/delivery/track/AHA-BW-100234"
          }
        },
        {
          "name": "1.8 Giao hàng: Webhook / Cập nhật trạm kiểm soát",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKeyPartner}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingCode\": \"GHN-VN-100582\",\n  \"status\": \"delivering\",\n  \"location\": \"Tuyến phố Xuân Thủy\",\n  \"description\": \"Shipper đang gọi khách giao bưu phẩm\"\n}"
            },
            "url": "{{baseUrl}}/api/delivery/update-status"
          }
        }
      ]
    },
    {
      "name": "Luồng 2: Mua bán sách & Giao dịch",
      "item": [
        {
          "name": "2.1 Sách: Tìm kiếm & Lọc danh mục",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books?category=kinh-te&sort=bestseller&limit=5"
          }
        },
        {
          "name": "2.2 Sách: Xem chi tiết sách & tình trạng",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/tam-ly-hoc-ve-tien"
          }
        },
        {
          "name": "2.3 Giỏ hàng: Tính toán tiền & chiết khấu",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"bookId\": \"tam-ly-hoc-ve-tien\", \"condition\": \"likenew\", \"qty\": 1 },\n    { \"bookId\": \"cha-giau-cha-ngheo\", \"condition\": \"seal\", \"qty\": 1 }\n  ],\n  \"shippingId\": \"standard\",\n  \"couponCodes\": [\"BOOKWISE50K\"]\n}"
            },
            "url": "{{baseUrl}}/api/orders/calculate-cart"
          }
        },
        {
          "name": "2.4 Giao dịch: Đặt hàng & Trừ kho (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Nguyễn Khách Mua\",\n    \"phone\": \"0909123456\",\n    \"email\": \"khachmua@gmail.com\",\n    \"province\": \"TP. Hồ Chí Minh\",\n    \"district\": \"Quận 1\",\n    \"street\": \"10 Đồng Khởi\"\n  },\n  \"items\": [\n    { \"bookId\": \"tam-ly-hoc-ve-tien\", \"condition\": \"seal\", \"qty\": 1 }\n  ],\n  \"shippingId\": \"standard\",\n  \"paymentId\": \"vietqr\",\n  \"couponCodes\": [\"BOOKWISE50K\"],\n  \"note\": \"Bọc cẩn thận giúp shop\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/checkout"
          }
        },
        {
          "name": "2.5 Thanh toán: Xác thực thanh toán VietQR / OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderCode\": \"BW-100791\",\n  \"paymentMethod\": \"card\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/process-payment"
          }
        },
        {
          "name": "2.6 Thu mua: Định giá sách cũ (Buyback Estimate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"khoi-nghiep-tinh-gon\",\n  \"condition\": \"likenew\"\n}"
            },
            "url": "{{baseUrl}}/api/buybacks/estimate"
          }
        },
        {
          "name": "2.7 Thu mua: Gửi yêu cầu bán lại sách cũ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookTitle\": \"Sapiens: Lược sử loài người\",\n  \"author\": \"Yuval Noah Harari\",\n  \"condition\": \"likenew\",\n  \"customerName\": \"Nguyễn Văn Bán Sách\",\n  \"phone\": \"0988776655\",\n  \"email\": \"bansach@gmail.com\",\n  \"address\": \"45 Hai Bà Trưng, Quận 3, TP.HCM\",\n  \"bankName\": \"MB Bank\",\n  \"bankAccount\": \"0988776655\",\n  \"accountHolder\": \"NGUYEN VAN BAN SACH\"\n}"
            },
            "url": "{{baseUrl}}/api/buybacks"
          }
        }
      ]
    },
    {
      "name": "Luồng 3: Theo dõi đơn hàng (Order Tracking)",
      "item": [
        {
          "name": "3.1 Tra cứu đơn hàng theo mã đơn (Public Tracking)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/track/BW-100582"
          }
        },
        {
          "name": "3.2 Tra cứu đơn hàng qua SĐT / Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0903123456\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/lookup"
          }
        },
        {
          "name": "3.3 Khách tự huỷ đơn (khi đơn còn pending)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Đặt nhầm số lượng\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/BW-100912/cancel"
          }
        },
        {
          "name": "3.4 Admin / Shipper cập nhật trạng thái đơn",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKeyAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipping\",\n  \"note\": \"Bưu tá đã xuất phát đi giao\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/BW-100791/status"
          }
        }
      ]
    }
  ]
}
